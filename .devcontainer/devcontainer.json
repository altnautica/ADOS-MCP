{
  "name": "ADOS MCP",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "dev",
  "runServices": ["dev"],
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "remoteUser": "node",
  "postCreateCommand": "pnpm install --frozen-lockfile",
  "forwardPorts": [8091],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "vitest.explorer"]
    }
  }
}
